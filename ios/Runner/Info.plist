<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Kinnect</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>kinnect</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.emre.kinnect</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>kinnect</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.71608708372-9dvs03siqhcg5o9g8f7q6haatc1ismcn</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>io.supabase.flutter</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>spotify</string>
			<string>kinnect</string>
			<string>https</string>
			<string>http</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSAppleMusicUsageDescription</key>
		<string>This app requires access to Apple Music to show your currently playing song on your profile.</string>
		<key>NSCameraUsageDescription</key>
		<string>Camera access is needed for taking photos, recording videos, and making video calls.</string>
		<key>NSMediaLibraryUsageDescription</key>
		<string>We need access to your media library to display currently playing music on your profile.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Microphone access is needed for voice and video calls.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Photo library access is needed to upload profile photos and share posts.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>We need your location to add location tags to your posts.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>We need your location to add location tags to your posts even when the app is in the background.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>We need your location to add location tags to your posts.</string>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>Kinnect uses Bluetooth to detect nearby friends and show you who's around (Spark Mode).</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>Kinnect broadcasts your presence to nearby friends when Spark Mode is enabled.</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>fetch</string>
			<string>bluetooth-central</string>
			<string>bluetooth-peripheral</string>
		</array>
